// Ядро MVP по PLAN.md, раздел 3. Дуэли, друзья и рейтинг — следующими миграциями.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BodyPart {
  chest
  back
  arms
  legs
  core
  cardio
}

enum WorkoutType {
  strength
  cardio
}

enum WorkoutStatus {
  accepted
  flagged
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String
  /// Подтверждение 18+ (ТЗ): без него аккаунт не создаётся.
  adultConfirmedAt DateTime
  createdAt        DateTime  @default(now())
  /// Блокировка за нарушения (src/admin/admin.ts): вход и обновление сессии закрыты.
  bannedAt         DateTime?
  banReason        String?

  profile       Profile?
  nicknameHolds NicknameHold[]
  avatarParts   AvatarPart[]
  workouts      Workout[]
  entryTests    EntryTest[]
  xpEvents      XpEvent[]
  walletTx      WalletTx[]
  refreshTokens RefreshToken[]
  inventory     InventoryItem[]
  duels         Duel[]
  sentFriendRequests     Friendship[] @relation("FriendRequester")
  receivedFriendRequests Friendship[] @relation("FriendAddressee")
  devices                DeviceToken[]
  notifications          Notification[]
  clientLogs             ClientLog[]
  jointSessions          JointSession[]
  jointMemberships       JointMember[]
  adminActions           AdminAction[]
  feedEvents             FeedEvent[]
  feedFists              FeedFist[]
  pairsStarted           StreakPair[] @relation("PairA")
  pairsJoined            StreakPair[] @relation("PairB")
}

model Profile {
  userId           String    @id @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname         String    @unique
  /// Ключ уникальности ника: без регистра, пробелов и похожих латинских букв (src/game/nickname.ts).
  nicknameKey      String    @unique
  /// Последняя смена ника; null — ещё не менял (первая смена — сразу).
  nicknameChangedAt DateTime?
  /// Витрина профиля: аватарка, фон, поза героя (видят друзья).
  showcase         Json?
  /// Бустеры за серию на следующую тренировку: {xp, coins} — сколько штук.
  boosters         Json      @default("{}")
  /// День, за который уже начислены шаги дня отдыха (YYYY-MM-DD).
  stepsRewardDay   String?
  /// Последняя выданная веха героя (средний уровень 5/10/20).
  heroMilestone    Int       @default(0)
  goal             String
  /// Дополнительные цели (до двух, п. 100); главная — goal.
  goals            String[]  @default([])
  trainingFormat   String
  /// 0 = понедельник … 6 = воскресенье.
  scheduleDays     Int[]
  /// Последняя смена графика игроком; null — ещё не менял (первая смена — в любой момент).
  formatChangedAt  DateTime?
  /// Внешность аватара и косметика (AvatarLook с клиента).
  appearance       Json
  /// Образ «Старт» на экране прогресса: фиксируется кнопкой или сам по истечении startLookUntil.
  startAppearance  Json?
  startLockedAt    DateTime?
  /// До этой даты образ собирается бесплатно (src/game/start-look.ts).
  startLookUntil   DateTime  @default(dbgenerated("(now() + '14 days'::interval)"))
  /// Согласие на обработку данных о пульсе (152-ФЗ, ст. 10); null — нет согласия, пульс не принимается.
  healthConsentAt  DateTime?
  /// Версия политики (дата), на которую дано или отозвано согласие.
  consentPolicy    String?
  /// Очки отдельных мышц (src/game/muscles.ts); null — ещё не посчитаны по истории тренировок.
  musclePoints     Json?
  age              Int?
  restingHr        Int?
  /// IANA, например Europe/Moscow: по нему считаются календарные дни и серия.
  timezone         String    @default("UTC")
  streakDays       Int       @default(0)
  /// YYYY-MM-DD в часовом поясе пользователя.
  lastActiveDay    String?
  /// День, когда уже напомнили «серия под угрозой» (YYYY-MM-DD), чтобы не слать дважды.
  streakReminderDay String?
  /// Какие пуши слать и во сколько напоминать о серии (см. src/push/settings.ts).
  notificationSettings Json @default("{}")
  /// Лига: 0 — бронзовая, 1 — серебряная, 2 — золотая (src/game/league.ts).
  leagueTier       Int       @default(0)
  /// Сезон (src/game/season.ts): номер, очки и до какого уровня выданы награды дорожек.
  seasonNumber     Int       @default(0)
  seasonPoints     Int       @default(0)
  seasonFree       Int       @default(0)
  seasonPremium    Int       @default(0)
  /// Ауры (src/game/aura.ts): тренировок каждой, выбранная, неделя и сколько тренировок в ней.
  auras            Json      @default("{}")
  auraEquipped     String?
  auraWeek         String?
  auraSessions     Int       @default(0)
  /// День последней тренировки ауры: не больше одной в день.
  auraLastDay      String?
  /// Понедельник недели, до которой лига уже подведена (YYYY-MM-DD).
  leagueWeek       String?
  /// Итог последней подведённой недели: место и куда сдвинулась лига.
  leagueLast       Json?
  /// День, за который уже выдана награда за «Совет дня» (YYYY-MM-DD).
  tipRewardDay     String?
  /// Дни, когда уже напомнили о совете дня и о новых дуэлях — не чаще раза в день.
  tipReminderDay   String?
  duelsReminderDay String?
  /// День, когда уже напомнили «скоро твоё время тренировки».
  trainingReminderDay String?
  /// Бета-тестер: премиум навсегда, без штрафа за тренировки без часов, эксклюзивные вещи.
  isTester         Boolean   @default(false)
  /// Оплаченный премиум до этой даты (оплаты пока нет).
  premiumUntil     DateTime?
  updatedAt        DateTime  @updatedAt
}

/// 6 строк на пользователя. Уровень считается из xp.
model AvatarPart {
  userId String   @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  part   BodyPart
  xp     Int      @default(0)

  @@id([userId, part])
}

model Workout {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Id с клиента: повторная отправка после обрыва связи не начислит опыт дважды.
  clientId   String
  type       WorkoutType
  startedAt  DateTime
  endedAt    DateTime
  /// YYYY-MM-DD в часовом поясе пользователя — для серии, календаря и лиги.
  day        String
  validity   Float
  status     WorkoutStatus @default(accepted)
  /// Подходы (силовая) или вид активности (кардио) — как прислал клиент.
  payload    Json
  /// Сводка пульса (src/game/pulse-summary.ts): avg, min, max, по минутам. Старые записи — [{at, bpm}].
  pulse      Json
  createdAt  DateTime      @default(now())

  xpEvents XpEvent[]

  @@unique([userId, clientId])
  @@index([userId, day])
}

/// Append-only журнал начислений опыта (PLAN 3).
model XpEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId String?  @db.Uuid
  workout   Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  part      BodyPart
  xp        Int
  validity  Float
  wasLagging Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Append-only журнал монет. Баланс = сумма amount.
model WalletTx {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Храним только хеш: утечка базы не даёт войти.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Купленная косметика. Цены знает только сервер (src/game/shop.ts).
model InventoryItem {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId     String
  acquiredAt DateTime @default(now())

  @@id([userId, itemId])
}

/// Журнал дуэлей. Снимки бойцов и seed позволяют воспроизвести любой бой.
model Duel {
  id          String   @id @default(uuid()) @db.Uuid
  attackerId  String   @db.Uuid
  attacker    User     @relation(fields: [attackerId], references: [id], onDelete: Cascade)
  /// bot — бот дня, user — друг.
  opponentKind String
  opponentId  String
  /// YYYY-MM-DD в часовом поясе атакующего.
  day         String
  seed        Int
  snapshotA   Json
  snapshotD   Json
  powerA      Int
  powerD      Int
  log         Json
  attackerWon Boolean
  coins       Int
  createdAt   DateTime @default(now())

  /// С ботом — снова через 5 часов, с другом — раз в день (проверяет сервис).
  @@index([attackerId, opponentId, day])
  @@index([attackerId, day])
  /// Лента «кто на тебя нападал».
  @@index([opponentKind, opponentId, createdAt])
}

enum FriendshipStatus {
  pending
  accepted
}

/// Заявка или дружба. Одна строка на пару: requester → addressee.
model Friendship {
  requesterId String           @db.Uuid
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String           @db.Uuid
  addressee   User             @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now())

  @@id([requesterId, addresseeId])
  @@index([addresseeId])
}

/// FCM-токен устройства для пушей. Один пользователь — несколько устройств.
model DeviceToken {
  token     String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Лента уведомлений: всё, что ушло пушем (и то, что не ушло — пуши выключены).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// friend_request | friend_accepted | attacked | streak_risk
  type      String
  title     String
  body      String
  /// Куда вести по нажатию: friends | duels | home.
  screen    String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Логи приложения с телефонов тестеров — для отладки. Хранятся 14 дней.
model ClientLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// null — игрок не вошёл в аккаунт (лог пришёл анонимно).
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Случайный id установки приложения: связывает логи до и после входа.
  installId  String
  /// Время события на телефоне.
  at         DateTime
  /// error | warn | info
  level      String
  message    String
  stack      String?
  appVersion String
  os         String
  env        String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([installId, at])
  @@index([userId, at])
}

/// Совместная тренировка (ТЗ 3.2): хозяин показывает код, друзья рядом его вводят.
model JointSession {
  id        String        @id @default(uuid()) @db.Uuid
  hostId    String        @db.Uuid
  host      User          @relation(fields: [hostId], references: [id], onDelete: Cascade)
  code      String
  /// До этого времени можно подключиться по коду.
  codeUntil DateTime
  /// До этого времени тренировки участников получают бонус.
  endsAt    DateTime
  createdAt DateTime      @default(now())
  members   JointMember[]

  @@index([code, codeUntil])
}

model JointMember {
  sessionId String       @db.Uuid
  session   JointSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime     @default(now())

  @@id([sessionId, userId])
  @@index([userId, joinedAt])
}

/// Журнал действий администратора (src/admin/admin.ts): кто что выдал, кого заблокировал.
model AdminAction {
  id      String   @id @default(uuid()) @db.Uuid
  at      DateTime @default(now())
  command String
  userId  String?  @db.Uuid
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  details Json

  @@index([at])
}

/// Прежний ник игрока закреплён за ним NICKNAME_HOLD_DAYS дней после смены: его нельзя сразу занять.
model NicknameHold {
  key    String   @id
  userId String   @db.Uuid
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  until  DateTime

  @@index([userId])
}

/// Напарник по серии (PLAN 4.8, п. 6): общая серия в неделях. a — пригласил, b — принял.
model StreakPair {
  id        String    @id @default(uuid()) @db.Uuid
  aId       String    @db.Uuid
  a         User      @relation("PairA", fields: [aId], references: [id], onDelete: Cascade)
  bId       String    @db.Uuid
  b         User      @relation("PairB", fields: [bId], references: [id], onDelete: Cascade)
  /// pending — ждёт ответа, active — серия идёт.
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  /// Понедельник недели, с которой считается общая серия (YYYY-MM-DD).
  since     String?

  @@index([aId])
  @@index([bId])
}

/// Лента друзей (PLAN 4.8, п. 7): события без пульса и тренировок по дням.
model FeedEvent {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// level_up | streak | comeback | hero_level | pair_week
  kind      String
  data      Json
  createdAt DateTime   @default(now())
  fists     FeedFist[]

  @@index([userId, createdAt])
}

/// Реакция «кулак» на событие ленты.
model FeedFist {
  eventId String    @db.Uuid
  event   FeedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String    @db.Uuid
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

/// Входная тренировка (п. 116): результаты для уровня игрока и статистики «как приложение
/// улучшает форму». Первая и повторные (раз в ~4 недели).
model EntryTest {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Id с клиента: повторная отправка не начислит монеты дважды.
  clientId  String
  at        DateTime
  /// Результаты по упражнениям: { pushUps, kneePushUps, squats60, crunches60, burpees60, plankSec, pullUps? }.
  results   Json
  /// Уровень, который вышел на телефоне (novice / intermediate / advanced).
  level     String
  coins     Int
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
  @@index([userId, at])
}
