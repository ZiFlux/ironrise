# Скопируйте в .env. Значения совпадают с docker-compose.yml (только для разработки).
DATABASE_URL=postgresql://ironrise:ironrise@localhost:5432/ironrise
PORT=3000
# Не меньше 32 символов. В продакшене — случайный секрет из хранилища секретов.
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
