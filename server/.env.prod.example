# Скопируйте в .env.prod на сервере и заполните. Файл не попадает в git.
# Случайные значения: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DOMAIN=api.example.ru
DB_PASSWORD=
JWT_SECRET=
# Путь к ключу Firebase внутри контейнера (server/secrets/firebase.json → /app/secrets/firebase.json).
FIREBASE_SERVICE_ACCOUNT=
# Ключ веб-админки (/admin), не короче 32 знаков. Пусто — веб-админка выключена.
ADMIN_TOKEN=
# E-mail аккаунта админа в приложении — туда придут пуши античита (п. 113). Пусто — не слать.
ADMIN_NOTIFY_EMAIL=
# Письма с логами античита на ADMIN_NOTIFY_EMAIL. Пример — Яндекс: SMTP_HOST=smtp.yandex.ru,
# SMTP_USER=ящик@yandex.ru, SMTP_PASS=пароль приложения (Яндекс ID → Безопасность → Пароли приложений).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
