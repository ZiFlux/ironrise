# Образ API на VPS: образ зависимостей + свежий код. Собирается на самом VPS —
# это только копирование файлов, памяти почти не нужно (deploy/push.ps1, п. 126).
ARG DEPS
FROM ironrise-api-deps:${DEPS}
ENV NODE_ENV=production
# CLI Prisma нужен в рантайме для migrate deploy — он в node_modules образа зависимостей.
COPY dist ./dist
COPY package.json prisma.config.ts ./
COPY prisma ./prisma
EXPOSE 3000
USER node
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main.js"]
