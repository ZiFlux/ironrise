# Скопируйте в .env.beta и заполните. Файл не попадает в git.
# Случайные значения можно получить командой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DB_PASSWORD=
JWT_SECRET=
# Путь внутри контейнера к ключу Firebase (положите файл в server/secrets/). Пусто — пуши выключены.
FIREBASE_SERVICE_ACCOUNT=
