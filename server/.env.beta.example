# Скопируйте в .env.beta и заполните. Файл не попадает в git.
# Случайные значения можно получить командой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DB_PASSWORD=
JWT_SECRET=
# Ключ Firebase кладётся в server/secrets/firebase.json; здесь — путь к нему ВНУТРИ контейнера
# (папка server/secrets подключена как /app/secrets): /app/secrets/firebase.json. Пусто — пуши выключены.
FIREBASE_SERVICE_ACCOUNT=
